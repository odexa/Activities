{
  "name": "@expo/ws-tunnel",
  "version": "2.1.0",
  "license": "MIT",
  "main": "./build",
  "files": [
    "build"
  ],
  "scripts": {
    "build": "ncc build src/index.ts --out build --minify --external ws --external fetch-nodeshim --external 2g",
    "test": "jest",
    "lint": "eslint . --ext ts,tsx"
  },
  "peerDependencies": {
    "ws": "^8.0.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.5",
    "@types/ws": "^8.5.13",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^8.57.1",
    "eslint-config-universe": "^14.0.0",
    "jest": "^29.7.0",
    "prettier": "^3.4.2",
    "ts-jest": "^29.2.5",
    "typescript": "^6.0.2",
    "ws": "^8.19.0"
  },
  "eslintConfig": {
    "extends": "universe",
    "ignorePatterns": [
      "build"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+.tsx?$": [
        "ts-jest"
      ]
    }
  },
  "prettier": {
    "printWidth": 100,
    "tabWidth": 2,
    "singleQuote": true,
    "bracketSameLine": true
  },
  "dependencies": {
    "2g": "^1.0.1",
    "fetch-nodeshim": "^0.4.11"
  }
}
